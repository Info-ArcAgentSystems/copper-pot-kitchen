# Machine-local Claude Code settings. launch.json IS shared — it documents how to
# run the dev server — but the permission allowlist is per-machine noise.
.claude/settings.local.json

# Secrets — never commit. .env.example is the committed template.
.env
.env.local

# Supabase machine-local link state. NOT committed: `.temp/pooler-url` carries a
# database connection string, and the linked ref is per-machine anyway. The ref
# that matters is recorded in supabase/config.toml and baked into the npm
# scripts, which is what stops a deploy defaulting to the wrong project.
supabase/.temp/

# Playwright
test-results
playwright-report
