{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    /* No DOM. The engine and its tests must run under plain Node — if a test ever
       needs a browser global, that is a signal the engine has stopped being pure.

       A test that IMPORTS A SCREEN needs DOM types, because the screen has them
       in its own signatures. Those live in `tsconfig.render.json` and are named
       `*.render.test.ts`, excluded below. This line does not move for them. */
    "lib": ["ES2023"],

    /* Lets a test typecheck an import of a .tsx module — `sourceNoticeRender`
       renders SourceNotice through `renderToStaticMarkup` to assert the words a
       person reads, not just the shape. This does NOT weaken the line above:
       `jsx` governs how JSX is parsed, `lib` governs what globals exist, and DOM
       is still absent. The test itself uses `createElement`, not JSX. */
    "jsx": "react-jsx",
    "types": ["node"],
    "skipLibCheck": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["tests"],
  "exclude": ["tests/**/*.render.test.ts"]
}
